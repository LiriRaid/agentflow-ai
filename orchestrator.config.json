{
  "projectName": "Test Project",
  "workspaceLanguage": "en",
  "maxConcurrent": 5,
  "pollIntervalSeconds": 5,
  "taskTimeoutMinutes": 30,
  "repos": {
    "backend": "C:\\Users\\liria\\Proyectos\\test-backend",
    "frontend": "C:\\Users\\liria\\Proyectos\\test-frontend"
  },
  "agentProfiles": {
    "claude": {
      "enabled": true,
      "localConfigDir": ".claude",
      "skillsDir": ".claude/skills",
      "primary": true,
      "useForOrchestration": true,
      "notes": "Primary profile for project orchestration."
    },
    "codex": {
      "enabled": true,
      "localConfigDir": ".codex",
      "primary": false,
      "useForOrchestration": false,
      "notes": "Support profile for structured implementation."
    },
    "opencode": {
      "enabled": true,
      "localConfigDir": ".opencode",
      "primary": false,
      "useForOrchestration": false,
      "notes": "Support profile for exploration and implementation. Uses whatever model you have configured in OpenCode."
    },
    "gemini": {
      "enabled": false,
      "localConfigDir": ".gemini"
    },
    "cursor": {
      "enabled": false,
      "localConfigDir": ".cursor"
    },
    "abacusai": {
      "enabled": false,
      "localConfigDir": ".abacus"
    }
  },
  "agents": {
    "Backend": {
      "cli": "claude",
      "profile": "claude",
      "defaultRepo": "backend",
      "instructionsFile": "agents/BACKEND.md"
    },
    "Frontend": {
      "cli": "claude",
      "profile": "claude",
      "defaultRepo": "frontend",
      "instructionsFile": "agents/FRONTEND.md"
    },
    "Codex": {
      "cli": "codex",
      "profile": "codex",
      "defaultRepo": "backend",
      "instructionsFile": "agents/CODEX.md"
    },
    "OpenCode": {
      "cli": "opencode",
      "profile": "opencode",
      "defaultRepo": "frontend",
      "instructionsFile": "agents/OPENCODE.md"
    },
    "Gemini": {
      "cli": "gemini",
      "profile": "gemini",
      "defaultRepo": "frontend",
      "instructionsFile": "agents/GEMINI.md"
    },
    "Cursor": {
      "cli": "cursor",
      "profile": "cursor",
      "defaultRepo": "backend",
      "instructionsFile": "agents/CURSOR.md"
    },
    "Abacus": {
      "cli": "abacusai",
      "profile": "abacusai",
      "defaultRepo": "backend",
      "instructionsFile": "agents/ABACUS.md"
    }
  }
}